# Database Configuration
# For local development with XAMPP defaults, you don't even need this file!
# Use this when deploying to cloud hosting (Railway, Render, TiDB Cloud, Aiven, cPanel, etc.)

# Option A: Single connection URL (often provided by Railway, Render, etc.)
# DATABASE_URL=mysql://root:password@containers-us-west-1.railway.app:3306/coaching_management

# Option B: Individual database credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coaching_management
DB_USER=root
DB_PASSWORD=

# Set to true if your cloud database requires SSL (e.g. TiDB Cloud, Aiven)
DB_SSL=false
# DB_SSL_CA=/path/to/ca.pem

# Environment: 'development' or 'production'
APP_ENV=development
